{
  "name": "habit-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Daily habits, weekly goals and to-dos in one offline home-screen app.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
